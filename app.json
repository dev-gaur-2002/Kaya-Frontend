{
  "expo": {
    "name": "Kaya",
    "slug": "kaya",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "kaya",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#EFEAE2"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.devgaur.kaya"
    },
    "android": {
      "package": "com.devgaur.kaya",
      "adaptiveIcon": {
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png",
        "backgroundColor": "#EFEAE2"
      }
    },
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "photosPermission": "Kaya uses your photos so you can send it a picture of a meal.",
          "cameraPermission": "Kaya uses the camera so you can photograph a meal and send it."
        }
      ]
    ],
    "extra": {
      "apiUrl": "https://kaya-backend.vercel.app",
      "supabaseUrl": "",
      "supabaseAnonKey": "",
      "eas": {
        "projectId": ""
      }
    }
  }
}
